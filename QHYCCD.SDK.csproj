<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<RootNamespace>QHYCCD.SDK</RootNamespace>
	<AssemblyName>QHYCCD.SDK</AssemblyName>
	<PackageLicenseFile>license.txt</PackageLicenseFile>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<DebugType>embedded</DebugType>
	<PackageId>QHYCCD.SDK</PackageId>
	<PackageTags>Astronomy,QHY,QHYCCD</PackageTags>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<RepositoryUrl>https://github.com/SharpAstro/QHYCCD.SDK</RepositoryUrl>
	<PackageProjectUrl>https://github.com/SharpAstro/QHYCCD.SDK</PackageProjectUrl>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<Description>Implements accessing the QHYCCD cameras using .NET</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	<CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	<CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>

  <ItemGroup>
	<None Include="license.txt" PackagePath="" Pack="True" />
	<None Include="lib/x86/qhyccd.dll" PackagePath="runtimes/win-x86/native" Pack="True" />
	<None Include="lib/x64/qhyccd.dll" PackagePath="runtimes/win-x64/native" Pack="True" />
	<None Include="lib/linux-x64/libqhyccd.so" PackagePath="runtimes/linux-x64/native" Pack="True" />
	<None Include="lib/linux-arm64/libqhyccd.so" PackagePath="runtimes/linux-arm64/native" Pack="True" />
	<None Include="lib/osx/libqhyccd.dylib" PackagePath="runtimes/osx/native" Pack="True" />
  </ItemGroup>

  <!--
    The PackagePath entries above serve the NuGet package, and ONLY it. The runtimes/rid/native
    layout is a NuGet resolution mechanism, so a consumer taking this project by ProjectReference
    gets the managed assembly and no native library at all. Every SharpAstro consumer does exactly
    that on a dev box, because UseLocalSiblings self-enables when the sibling clone is present, so
    the QHY drivers found no camera there while working perfectly from the published package. That
    is worse than the usual UseLocalSiblings trap: not a stale version but an absent capability, and
    silent, because a missing DllImport target looks the same as no camera being plugged in.

    Copying beside the consumer's binary is the fix: the app directory is where the runtime probes
    for a DllImport, whereas a runtimes folder in an output directory is not probed without the
    deps.json entry only a package supplies. Update rather than a second Include, so the metadata
    lands on the item declared above instead of duplicating it.

    Selected by RID, where this used to test the OS alone and pick x64 unconditionally. On an
    arm64 Linux box that copied lib/linux-x64/libqhyccd.so, which is WORSE than copying nothing: a
    wrong-architecture native fails to load with an error about the file rather than an obvious
    absence, so it reads as a corrupt library instead of an unsupported one. linux-arm64 is not a
    hypothetical target here either, being the headless Raspberry Pi path, and the correct .so was
    sitting in lib/linux-arm64 the whole time, packaged and never copied. The same went for a
    win-x86 build, which got the x64 DLL.

    QHY ships no linux-arm (32-bit) and no win-arm64 binary, so those RIDs map to nothing and
    nothing is copied, which is the honest answer rather than an oversight. macOS has one directory
    rather than a per-architecture pair, matching its single runtimes/osx/native package path, so
    both osx-x64 and osx-arm64 resolve to it.

    ZWOptical.SDK carries the same RID mapping, arrived at independently because its layout forced
    it: there lib/x64 holds BOTH the Windows .dll and the Linux .so. The two repos differ in their
    directory names, so the mappings cannot be shared, only kept in the same shape.
  -->
  <PropertyGroup>
	<_QhyNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_QhyNativeRid>
	<_QhyNativeRid Condition="'$(_QhyNativeRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_QhyNativeRid>
	<!-- Never empty past here, so the StartsWith calls below always have a string to run on. -->
	<_QhyNativeRid Condition="'$(_QhyNativeRid)' == ''">unknown</_QhyNativeRid>

	<_QhyNativeDir Condition="'$(_QhyNativeRid)' == 'win-x64'">lib/x64</_QhyNativeDir>
	<_QhyNativeDir Condition="'$(_QhyNativeRid)' == 'win-x86'">lib/x86</_QhyNativeDir>
	<_QhyNativeDir Condition="'$(_QhyNativeRid)' == 'linux-x64'">lib/linux-x64</_QhyNativeDir>
	<_QhyNativeDir Condition="'$(_QhyNativeRid)' == 'linux-arm64'">lib/linux-arm64</_QhyNativeDir>
	<_QhyNativeDir Condition="$(_QhyNativeRid.StartsWith('osx-'))">lib/osx</_QhyNativeDir>

	<_QhyNativeFile Condition="$(_QhyNativeRid.StartsWith('win-'))">qhyccd.dll</_QhyNativeFile>
	<_QhyNativeFile Condition="$(_QhyNativeRid.StartsWith('linux-'))">libqhyccd.so</_QhyNativeFile>
	<_QhyNativeFile Condition="$(_QhyNativeRid.StartsWith('osx-'))">libqhyccd.dylib</_QhyNativeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(_QhyNativeDir)' != ''">
	<None Update="$(_QhyNativeDir)/$(_QhyNativeFile)" Link="$(_QhyNativeFile)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Take TianWen.DAL from the sibling checkout when there is one, exactly as tianwen does, and
    self-enable on Exists() so no switch has to be passed.

    This is not a convenience. With an unconditional PackageReference here, a consumer building
    BOTH this project and TianWen.DAL from source still pulled the PUBLISHED DAL in through this
    reference, so two assemblies with the same simple name reached the compiler and it refused
    them outright (CS1704). Raising the sibling's version only wins until CI publishes the next
    patch of that same minor, which is exactly what happened: 2.1.241 went out, the sibling built
    as 2.1.0, and 2.1.251 then took the lead back. There is no version to pick that stays ahead,
    so the reference itself has to go away when the source is present.

    A build with no sibling, CI included, is unaffected and still restores the package.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\TianWen.DAL\TianWen.DAL.csproj')">
	<ProjectReference Include="..\TianWen.DAL\TianWen.DAL.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\TianWen.DAL\TianWen.DAL.csproj')">
	<PackageReference Include="TianWen.DAL" Version="3.2.*" />
  </ItemGroup>

</Project>
